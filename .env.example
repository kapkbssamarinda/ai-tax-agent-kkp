# ==============================================================================
# Konfigurasi Environment Variables Lokal (AI Tax Agent Indonesia)
# Salin file ini menjadi `.env` atau `.env.local` di root folder project
# ==============================================================================

# 1. Anthropic Claude API Key (Wajib agar AI berfungsi saat dijalankan lokal)
CLAUDE_API_KEY=sk-ant-api03-xxxx-your-anthropic-api-key-here
# Alias alternatif yang didukung:
# ANTHROPIC_API_KEY=sk-ant-api03-xxxx...
# VITE_CLAUDE_API_KEY=sk-ant-api03-xxxx...

# 2. Google Identity Services (Google Sign-In OAuth 2.0 Client ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. Google Apps Script Web App Backend (Whitelist & Login Logs)
VITE_GAS_AUTH_URL=https://script.google.com/macros/s/AKfycb.../exec
VITE_GAS_SECRET_TOKEN=rahasia-token-gas-anda

# 4. Supabase Configuration (Opsional - jika masih digunakan untuk database legacy)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
